APP_NAME="Jobbie"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=sv
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sv_SE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=radar
DB_USERNAME=radar
DB_PASSWORD=radar

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# redis-long runs discovery jobs on their own queue (see README)
RADAR_LONG_QUEUE_CONNECTION=
RADAR_USER_AGENT="TeamtailorRadar/0.1 (+https://github.com/wheresmarco/jobbie)"
RADAR_HTTP_TIMEOUT=15
RADAR_HTTP_POOL_SIZE=10
RADAR_DNS_DRIVER=doh
RADAR_DOH_ENDPOINT=https://cloudflare-dns.com/dns-query
RADAR_DNS_TIMEOUT=5
RADAR_DNS_POOL_SIZE=50
RADAR_TLS_TIMEOUT=10
RADAR_DEAD_RECHECK_DAYS=30
RADAR_REJECTED_RECHECK_DAYS=60
RADAR_NEW_JOB_DAYS=7
RADAR_SOURCES=redirects,jobstream,prefixes,commoncrawl
RADAR_JOBSTREAM_BASE_URL=https://jobstream.api.jobtechdev.se
RADAR_JOBSTREAM_API_KEY=
RADAR_COMMONCRAWL_INDEXES=3
RADAR_TXT_RECHECK_DAYS=30
RADAR_SEARCH_API_KEY=
RADAR_SEARCH_API_PAGES=5
RADAR_HTTP_ARCHIVE_PROJECT=
RADAR_HTTP_ARCHIVE_CREDENTIALS=
RADAR_HTTP_ARCHIVE_DATE=
RADAR_HTTP_ARCHIVE_MAX_BYTES=214748364800
RADAR_BASIC_AUTH_USER=
RADAR_BASIC_AUTH_PASSWORD=
# Anyone can create an account on /register while this is true
RADAR_REGISTRATION=true
